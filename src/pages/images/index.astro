---
import Base from "~/layouts/Base.astro";
import ImageRow from "~/components/ImageRow.astro";
import { loadEnrichedImages } from "~/lib/images";

const images = await loadEnrichedImages();
const active = images.filter((i) => i.status !== "archive");
const archived = images.filter((i) => i.status === "archive");
const header = "grid-cols-[2.75rem_minmax(0,1fr)_9rem_8rem_6rem_1rem]";
---

<Base
  title="Image catalog"
  description="Every cloud image published by Open Image Cloud: versions, variants, sizes, checksums and provenance."
>
  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20">
    <p class="eyebrow">Catalog</p>
    <h1 class="text-ink mt-3 text-4xl font-semibold tracking-tight">Image catalog</h1>
    <p class="text-ink-muted mt-4 leading-relaxed text-pretty">
      Each image lives at a versioned, immutable path on{" "}
      <a class="link" href="https://images.openimages.cloud/">
        images.openimages.cloud
      </a>
      , next to its checksums, signature bundle and{" "}
      <code class="font-mono text-sm">MANIFEST.json</code>. A&nbsp;
      <code class="font-mono text-sm">latest/</code> alias follows each release, but pin a version
      in anything you want to reproduce.
    </p>

    <div class="mt-10">
      <label class="relative block w-full">
        <span class="sr-only">Filter images</span>
        <svg
          viewBox="0 0 24 24"
          class="text-ink-faint pointer-events-none absolute top-1/2 left-3 h-4 w-4 -translate-y-1/2"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
        <input
          type="search"
          data-image-filter
          placeholder="Filter: alpine, uefi, octavia…"
          autocomplete="off"
          class="border-line-strong surface text-ink placeholder:text-ink-faint w-full rounded-lg border py-2.5 pr-24 pl-9 text-sm focus:outline-none focus-visible:border-[var(--accent)]"
        />
        <span
          class="text-ink-faint pointer-events-none absolute top-1/2 right-3 -translate-y-1/2 text-xs tabular-nums"
          data-filter-count
          aria-live="polite"
        >
          {images.length} images
        </span>
      </label>
    </div>

    <div class="border-line mt-6 overflow-hidden rounded-xl border">
      <div
        class:list={[
          "border-line surface-sunken hidden gap-x-4 border-b px-5 py-2.5 md:grid",
          header,
        ]}
      >
        <span></span>
        <span class="eyebrow">Image</span>
        <span class="eyebrow">Latest</span>
        <span class="eyebrow">Built</span>
        <span class="eyebrow text-right">Size</span>
        <span></span>
      </div>
      <ul class="divide-line divide-y" data-image-list>
        {active.map((image) => (
          <ImageRow image={image} />
        ))}
      </ul>
    </div>
    <p class="text-ink-faint mt-6 hidden text-sm" data-filter-empty>
      No image matches this filter.
    </p>

    {archived.length > 0 && (
      <div class="mt-14" data-archive-block>
        <h2 class="text-ink text-lg font-semibold">Archive</h2>
        <p class="text-ink-muted mt-1 text-sm">
          End of life upstream. Still rebuilt for existing workloads, not recommended for new
          deployments.
        </p>
        <div class="border-line mt-4 overflow-hidden rounded-xl border">
          <ul class="divide-line divide-y" data-image-list>
            {archived.map((image) => (
              <ImageRow image={image} />
            ))}
          </ul>
        </div>
      </div>
    )}

    <p class="text-ink-faint mt-14 text-sm">
      Missing a distribution?{" "}
      <a class="link" href="https://github.com/open-img-cloud/.github/issues">
        Open an issue
      </a>
      : adoption is driven by demand.
    </p>
  </section>

  <script>
    const input = document.querySelector<HTMLInputElement>("[data-image-filter]");
    const rows = [...document.querySelectorAll<HTMLElement>("[data-image-row]")];
    const count = document.querySelector("[data-filter-count]");
    const empty = document.querySelector("[data-filter-empty]");
    const archive = document.querySelector<HTMLElement>("[data-archive-block]");
    input?.addEventListener("input", () => {
      const terms = input.value.toLowerCase().split(/\s+/).filter(Boolean);
      let shown = 0;
      for (const row of rows) {
        const match = terms.every((t) => row.dataset.search?.includes(t));
        row.hidden = !match;
        if (match) shown++;
      }
      if (count) count.textContent = `${shown} image${shown === 1 ? "" : "s"}`;
      empty?.classList.toggle("hidden", shown > 0);
      if (archive) {
        archive.hidden = !rows.some((r) => r.dataset.status === "archive" && !r.hidden);
      }
    });
  </script>
</Base>
