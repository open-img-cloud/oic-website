---
import StarCta from "~/components/StarCta.astro";
import { existsSync } from "node:fs";
import Base from "~/layouts/Base.astro";
import { inOsismExport } from "~/lib/catalog-index";
import { cmdArtifact, cmdImage } from "~/lib/command-data";
import { openstackCli, proxmoxQm } from "~/lib/commands";
import CodeBlock from "~/components/CodeBlock.astro";
import EolBadge from "~/components/EolBadge.astro";
import StatusBadge from "~/components/StatusBadge.astro";
import {
  CERT_IDENTITY_REGEXP,
  CERT_OIDC_ISSUER,
  downloadsWindowLabel,
  formatBytes,
  IMAGES_BASE_URL,
  formatDate,
  loadDownloadStats,
  loadEnrichedImages,
  loadMaintainedSeries,
  shortSha,
  supportText,
  type Artifact,
  type EnrichedImage,
} from "~/lib/images";

export async function getStaticPaths() {
  const images = await loadEnrichedImages();
  return images.map((image) => ({ params: { os: image.os_name }, props: { image } }));
}

interface Props {
  image: EnrichedImage;
}

const { image } = Astro.props;
const pkgs = image.packages;
const DIFF_ROWS = 60;
const diffCount = pkgs?.diff
  ? pkgs.diff.updated.length + pkgs.diff.added.length + pkgs.diff.removed.length
  : 0;
const diffTruncated =
  !!pkgs?.diff &&
  [pkgs.diff.updated, pkgs.diff.added, pkgs.diff.removed].some((l) => l.length > DIFF_ROWS);
// Per-series OpenStack images: name each previous series and say whether upstream still maintains it.
const maintainedSeries = image.openstack_series ? await loadMaintainedSeries() : [];
const seriesNote = (v: string) => {
  if (!image.openstack_series) return null;
  const s = maintainedSeries.find((m) => m.series === v);
  if (!s) return "unmaintained upstream";
  return s.until ? `${s.name}, maintained until ${formatDate(s.until)}` : s.name;
};

// Search titles and descriptions: say what the page offers, in the words people search for.
const SERVICE_IMAGES: Record<string, string> = {
  "octavia-amphora": "OpenStack Octavia load balancers",
  "manila-service-image": "the OpenStack Manila generic driver",
  "trove-guest-image": "OpenStack Trove databases",
};
const serviceFor = SERVICE_IMAGES[image.os_name];
// Share image made by scripts/export-og.mjs; the site-wide one until it has been generated.
const ogImage = existsSync(`public/img/og/${image.os_name}.png`)
  ? `/img/og/${image.os_name}.png`
  : undefined;
const imageWord = /image$/i.test(image.title) ? image.title : `${image.title} image`;
const seoTitle = image.seo_title
  ? image.seo_title
  : serviceFor
    ? `${imageWord} for OpenStack`
    : image.test_image
      ? `${image.title} test image for OpenStack`
      : // "qcow2" is how people search for these files; no brand suffix, so it stays under 60
        // characters (the site name still shows in og:site_name and in the search result).
        `${image.title} qcow2 cloud image for OpenStack & Proxmox`;
const brandInTitle = Boolean(serviceFor || image.test_image);
const seoDescription = image.seo_description
  ? image.seo_description
  : serviceFor
    ? `Signed ${imageWord} for ${serviceFor}, version ${image.latest_version}: qcow2 built per OpenStack series with diskimage-builder, cosign-verifiable.`
    : image.test_image
      ? `Signed ${image.title} ${image.latest_version} test image for OpenStack (Tempest, smoke tests), republished unchanged from upstream, boot-tested, cosign-verifiable. Not for production.`
      : `Signed ${image.title} qcow2 cloud image for OpenStack & Proxmox, version ${image.latest_version}: cloud-init ready${image.login_user ? `, user ${image.login_user}` : ""}, boot-tested, cosign-verifiable.`;
// Download counts, null when the statistics endpoint was unavailable at build time.
const stats = await loadDownloadStats();
const downloadsLabel = stats ? downloadsWindowLabel(stats) : "";
const plural = (n: number) => `${n.toLocaleString("en-US")} download${n === 1 ? "" : "s"}`;
const repoUrl = `https://github.com/${image.repo}`;
const logoUrl = image.logo ? `/img/logos/${image.logo}` : null;
const artifacts = image.latest.artifacts;
const primary: Artifact | undefined = artifacts.find((a) => a.fileUrl) ?? artifacts[0];
const p = image.provenance;
const loginUser = image.login_user;

// Quick-start snippets, built from the primary (first published) artifact by the builders the
// command generator (/get/) uses too. They use the versioned URL, never latest/, so the
// checksum always matches the downloaded file.
const cmdImg = cmdImage(image);
const cmd = cmdArtifact(image, primary);
const file = cmd.file;
const fileUrl = cmd.url;
const openstack = openstackCli(cmdImg, cmd);
const proxmox = proxmoxQm(cmdImg, cmd);
const getUrl = (target: string) =>
  `/get/?image=${encodeURIComponent(image.os_name)}${
    primary?.variantId && artifacts.length > 1
      ? `&variant=${encodeURIComponent(primary.variantId)}`
      : ""
  }&target=${target}`;

const osism = `curl -fsSo oic-images.yml ${IMAGES_BASE_URL}/osism/images.yml
openstack-image-manager --cloud admin --images oic-images.yml --latest`;

const verify = `curl -fLO ${fileUrl}
curl -fLO ${fileUrl}.bundle

cosign verify-blob ${file} \\
  --bundle ${file}.bundle --new-bundle-format \\
  --certificate-identity-regexp '${CERT_IDENTITY_REGEXP}' \\
  --certificate-oidc-issuer ${CERT_OIDC_ISSUER}`;

// Inline `code` spans in the YAML description.
const descriptionParts = image.description.trim().split(/(`[^`]+`)/g);

const provenance = [
  { label: "Version", value: image.latest_version, mono: true },
  { label: "Built", value: formatDate(image.builtAt) },
  p?.commit && {
    label: "Source commit",
    value: shortSha(p.commit),
    href: `${repoUrl}/commit/${p.commit}`,
    mono: true,
  },
  p?.build_url && {
    label: "CI run",
    value: `#${p.build_url.split("/").pop()}`,
    href: p.build_url,
    mono: true,
  },
  p?.builder_tool && { label: "Builder", value: p.builder_tool },
  p?.builder?.digest && {
    label: "Builder image",
    value: `${p.builder.image?.replace("ghcr.io/", "") ?? "image"}@${shortSha(p.builder.digest, 12)}`,
    mono: true,
  },
  p?.upstream_url && {
    label: "Upstream artefact",
    value: new URL(p.upstream_url).hostname,
    href: p.upstream_url,
  },
  { label: "Signature", value: image.signed ? "cosign keyless" : "unsigned" },
  image.downloads != null && {
    label: "Downloads",
    value: image.downloads.toLocaleString("en-US"),
    title: `All versions, ${downloadsLabel}`,
    mono: true,
  },
].filter(Boolean) as {
  label: string;
  value: string;
  href?: string;
  mono?: boolean;
  title?: string;
}[];
---

<Base
  title={seoTitle}
  brand={brandInTitle}
  feed={{ href: `/images/${image.os_name}/feed.xml`, title: `${image.title}: new versions` }}
  description={seoDescription}
  ogImage={ogImage}
  jsonLd={[
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Catalog",
          item: "https://openimages.cloud/images/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: image.title,
          item: `https://openimages.cloud/images/${image.os_name}/`,
        },
      ],
    },
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      name: serviceFor ? imageWord : `${image.title} cloud image`,
      description: seoDescription,
      applicationCategory: "Operating system image",
      operatingSystem: "OpenStack, Proxmox VE (QEMU/KVM)",
      softwareVersion: image.latest_version,
      ...(image.builtAt && { datePublished: image.builtAt.slice(0, 10) }),
      ...(primary?.fileUrl && { downloadUrl: primary.fileUrl }),
      ...(primary?.sizeBytes && { fileSize: formatBytes(primary.sizeBytes) }),
      url: `https://openimages.cloud/images/${image.os_name}/`,
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
      publisher: {
        "@type": "Organization",
        name: "Open Image Cloud",
        url: "https://openimages.cloud/",
      },
    },
  ]}
>
  <article class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-14">
    <nav aria-label="Breadcrumb" class="text-ink-faint text-sm">
      <a href="/images/" class="hover:text-ink">
        Catalog
      </a>
      <span class="mx-2" aria-hidden="true">
        /
      </span>
      <span class="text-ink-muted" aria-current="page">
        {image.title}
      </span>
    </nav>

    <header class="mt-6 flex flex-col gap-5 sm:flex-row sm:items-start">
      {logoUrl && (
        <span class="border-line flex h-16 w-16 bg-white dark:border-transparent shrink-0 items-center justify-center rounded-xl border">
          <img src={logoUrl} alt="" width="40" height="40" class="h-10 w-10" />
        </span>
      )}
      <div class="min-w-0 flex-1">
        <div class="flex flex-wrap items-center gap-3">
          <h1 class="text-ink text-3xl font-semibold tracking-tight sm:text-4xl">{image.title}</h1>
          <StatusBadge status={image.status} />
          <EolBadge support={image.support} />
        </div>
        <p class="text-ink-muted mt-2 text-lg">{image.tagline}</p>
        <p class="text-ink-faint mt-3 font-mono text-xs">
          {image.latest_version} · {image.format} · {image.arch}
          {loginUser && <> · user {loginUser}</>}
        </p>
      </div>
    </header>

    {image.support && (
      <p
        class:list={[
          "mt-6 rounded-lg border px-4 py-3 text-sm",
          image.support.isEol || image.support.eolSoon
            ? "border-[color-mix(in_oklch,var(--warn)_40%,transparent)] bg-[color-mix(in_oklch,var(--warn)_8%,transparent)]"
            : "border-line surface-sunken",
        ]}
        role="note"
      >
        <span
          class:list={[
            "font-medium",
            image.support.isEol || image.support.eolSoon ? "text-warn" : "text-ink",
          ]}
        >
          Support:{" "}
        </span>
        <span class="text-ink-muted">{supportText(image.support)}</span>{" "}
        <a class="link text-xs" href={image.support.sourceUrl}>
          Source: endoflife.date
        </a>
      </p>
    )}

    {image.status_note && (
      <p
        class:list={[
          image.support ? "mt-3" : "mt-6",
          "rounded-lg border border-[color-mix(in_oklch,var(--warn)_40%,transparent)] bg-[color-mix(in_oklch,var(--warn)_8%,transparent)] px-4 py-3 text-sm",
        ]}
        role="note"
      >
        <span class="text-warn font-medium">Note: </span>
        <span class="text-ink-muted">{image.status_note}</span>
      </p>
    )}

    <div class="mt-10 grid gap-10 lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-14">
      <div class="min-w-0">
        <!-- Downloads -->
        <section aria-labelledby="dl-title">
          <h2 id="dl-title" class="text-ink text-xl font-semibold tracking-tight">
            Download
          </h2>
          <ul class="mt-4 space-y-3">
            {artifacts.map((a) => (
              <li class="border-line rounded-xl border p-4 sm:p-5">
                <div class="flex flex-wrap items-start justify-between gap-3">
                  <div class="min-w-0">
                    {a.label && (
                      <p class="text-ink font-semibold">
                        {a.label}
                        {a.hint && (
                          <span class="text-ink-faint ml-2 text-sm font-normal">{a.hint}</span>
                        )}
                      </p>
                    )}
                    <p class="text-ink-muted mt-0.5 font-mono text-sm break-all">
                      {a.filename ?? "not published"}
                    </p>
                  </div>
                  {a.fileUrl ? (
                    <a
                      href={a.fileUrl}
                      class="bg-brand-600 hover:bg-brand-700 dark:bg-brand-500 dark:hover:bg-brand-400 inline-flex shrink-0 items-center gap-2 rounded-lg px-4 py-2 text-sm font-medium text-white transition-colors dark:text-slate-950"
                    >
                      <svg viewBox="0 0 16 16" class="h-3.5 w-3.5" fill="none" aria-hidden="true">
                        <path
                          d="M8 2v9m0 0l-3.5-3.5M8 11l3.5-3.5M2.5 13.5h11"
                          stroke="currentColor"
                          stroke-width="1.6"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                      {formatBytes(a.sizeBytes)}
                    </a>
                  ) : (
                    <span class="text-ink-faint text-sm">Unavailable</span>
                  )}
                </div>
                {a.manifest?.sha256 && (
                  <div class="border-line mt-4 flex items-center gap-2 border-t pt-3">
                    <span class="eyebrow shrink-0">sha256</span>
                    <code class="text-ink-muted min-w-0 flex-1 truncate font-mono text-xs">
                      {a.manifest.sha256}
                    </code>
                    <button
                      type="button"
                      data-copy={a.manifest.sha256}
                      class="text-ink-faint hover:text-ink shrink-0 rounded px-1.5 py-0.5 text-xs"
                      aria-label="Copy SHA-256"
                    >
                      <span data-copy-label>Copy</span>
                    </button>
                  </div>
                )}
                {a.fileUrl && (
                  <p class="text-ink-faint mt-3 flex flex-wrap gap-x-4 gap-y-1 text-xs">
                    <a class="hover:text-ink" href={a.bundleUrl ?? undefined}>
                      Signature bundle
                    </a>
                    <a class="hover:text-ink" href={a.manifestUrl}>
                      Manifest
                    </a>
                    <a class="hover:text-ink" href={`${a.fileUrl}.sha256`}>
                      .sha256
                    </a>
                    {a.downloads != null && (
                      <span title={downloadsLabel}>{plural(a.downloads)}</span>
                    )}
                    <a
                      class="hover:text-ink"
                      href={`https://images.openimages.cloud/${image.os_name}/${image.latest_version}/`}
                    >
                      All files
                    </a>
                  </p>
                )}
              </li>
            ))}
          </ul>
        </section>

        <!-- Quick start -->
        <section class="mt-14" aria-labelledby="qs-title">
          <h2 id="qs-title" class="text-ink text-xl font-semibold tracking-tight">
            Quick start
          </h2>
          {artifacts.length > 1 && (
            <p class="text-ink-muted mt-2 text-sm">
              Commands below use the {primary?.label} variant; swap the file name for another one.
            </p>
          )}
          <p class="text-ink-muted mt-2 text-sm">
            More targets and options (oic-sync, Terraform, cloud-init, names, storages):{" "}
            <a class="link" href={getUrl("openstack")}>
              command generator
            </a>
            .
          </p>
          <h3 class="text-ink mt-6 text-sm font-semibold">OpenStack</h3>
          <CodeBlock code={openstack} label="OpenStack Glance" />
          {image.test_image ? (
            <>
              <h3 class="text-ink mt-6 text-sm font-semibold">Proxmox VE</h3>
              <p class="text-ink-muted mt-1 text-sm">
                The disk boots on Proxmox VE (BIOS or UEFI) and gets its address by DHCP, but this
                test image ignores the Proxmox cloud-init drive: no SSH key or user is applied. Log
                in on the console with the well-known password instead.
              </p>
            </>
          ) : (
            <>
              <h3 class="text-ink mt-6 text-sm font-semibold">Proxmox VE</h3>
              <p class="text-ink-muted mt-1 text-sm">
                Creates a cloud-init template (VM 9000) on <code class="font-mono">local-lvm</code>.
                The <code class="font-mono">local</code> storage needs the Import content type
                (default on new Proxmox VE 9.1 installs). Adjust the storages, bridge and SSH key
                path to your setup.
              </p>
              <CodeBlock code={proxmox} label="Proxmox VE 9" />
              <p class="text-ink-muted text-sm">
                In the web UI: Datacenter &gt; Storage, edit <code class="font-mono">local</code>{" "}
                and add Import to its content; then on that storage, Import &gt; Download from URL
                with the URL above and the SHA-256 checksum, and pick the downloaded file as the
                import source when adding the VM disk. On Proxmox VE 8, download the file with{" "}
                <code class="font-mono">wget</code> and use{" "}
                <code class="font-mono">import-from=/root/{file}</code> instead.
              </p>
            </>
          )}
          <h3 class="text-ink mt-6 text-sm font-semibold">Verify before booting</h3>
          <CodeBlock code={verify} label="cosign 2.x / 3.x" />
          <p class="text-ink-muted text-sm">
            Expect <code class="text-ok font-mono">Verified OK</code>. Details in the{" "}
            <a class="link" href="/verify/">
              verification guide
            </a>
            .
          </p>
        </section>

        <!-- Keep up to date -->
        <section class="mt-14" aria-labelledby="sync-title">
          <h2 id="sync-title" class="text-ink text-xl font-semibold tracking-tight">
            Keep images up to date
          </h2>
          <p class="text-ink-muted mt-3 text-sm leading-relaxed">
            Automation should not scrape this page. The{" "}
            <a class="link" href={`${IMAGES_BASE_URL}/index.json`}>
              catalog index
            </a>{" "}
            lists the latest version of every image with versioned URLs, SHA-256 and SHA-512
            digests, sizes, firmware and the cosign identity
            {image.versionsUrl && (
              <>
                ; the{" "}
                <a class="link" href={image.versionsUrl}>
                  version history
                </a>{" "}
                of this image lists every published release
              </>
            )}
            . To hear about new versions, follow the{" "}
            <a class="link" href={`/images/${image.os_name}/feed.xml`}>
              Atom feed of this image
            </a>{" "}
            (or the{" "}
            <a class="link" href="/feed.xml">
              feed of the whole catalog
            </a>
            ).
            {inOsismExport(image.os_name, image.os_distro) && (
              <>
                {" "}
                OpenStack operators using{" "}
                <a class="link" href="https://github.com/osism/openstack-image-manager">
                  openstack-image-manager
                </a>{" "}
                can point it at the ready-made definitions:
              </>
            )}
          </p>
          {inOsismExport(image.os_name, image.os_distro) && (
            <CodeBlock code={osism} label="osism openstack-image-manager" />
          )}
          <p class="text-ink-muted mt-3 text-sm leading-relaxed">
            <a class="link" href="/oic-sync/">
              oic-sync
            </a>{" "}
            reads the index, verifies the signatures and keeps this image current
            {serviceFor || image.test_image ? (
              <>
                {" "}
                in{" "}
                <a class="link" href="/oic-sync/openstack/">
                  OpenStack Glance
                </a>
                . It skips this image unless named:{" "}
                <code class="font-mono">--image {image.os_name}</code>.
              </>
            ) : (
              <>
                {" "}
                in{" "}
                <a class="link" href="/oic-sync/openstack/">
                  OpenStack Glance
                </a>{" "}
                or as a{" "}
                <a class="link" href="/oic-sync/proxmox/">
                  Proxmox VE template
                </a>{" "}
                (<code class="font-mono">--image {image.os_name}</code>).
              </>
            )}
          </p>
        </section>

        <!-- About -->
        <StarCta />

        <section class="mt-14" aria-labelledby="about-title">
          <h2 id="about-title" class="text-ink text-xl font-semibold tracking-tight">
            About
          </h2>
          <p class="text-ink-muted mt-3 leading-relaxed">
            {descriptionParts.map((part) =>
              part.startsWith("`") ? (
                <code class="text-ink font-mono text-sm">{part.slice(1, -1)}</code>
              ) : (
                part.replace(/\s+/g, " ")
              ),
            )}
          </p>
          <ul class="mt-4 flex flex-wrap gap-2">
            {image.tags.map((tag) => (
              <li class="border-line text-ink-muted rounded-full border px-2.5 py-0.5 text-xs">
                {tag}
              </li>
            ))}
          </ul>
        </section>

        <!-- Packages -->
        {pkgs && (
          <section class="mt-14" id="packages" aria-labelledby="pkg-title">
            <h2 id="pkg-title" class="text-ink text-xl font-semibold tracking-tight">
              Packages
            </h2>
            <p class="text-ink-muted mt-2 text-sm leading-relaxed">
              {pkgs.packages.length.toLocaleString("en-US")} {pkgs.format ?? ""} packages in{" "}
              <span class="text-ink font-mono">{pkgs.version}</span>. Listed from the published
              image after its release (
              <a class="link" href={pkgs.url}>
                packages.json
              </a>
              ). The list is not signed itself: it records the sha256 of the image it was read from,
              which matches the signed manifest.
            </p>
            {pkgs.diff && (
              <div class="mt-5">
                <h3 class="text-ink text-base font-semibold">
                  Changes since <span class="font-mono">{pkgs.diff.previousVersion}</span>
                </h3>
                {diffCount === 0 ? (
                  <p class="text-ink-muted mt-2 text-sm">No package changed.</p>
                ) : (
                  <>
                    <p class="text-ink-muted mt-2 text-sm">
                      {pkgs.diff.updated.length} updated, {pkgs.diff.added.length} added,{" "}
                      {pkgs.diff.removed.length} removed.
                    </p>
                    <div class="border-line mt-3 overflow-x-auto rounded-xl border">
                      <table class="w-full text-left text-sm">
                        <thead class="surface-sunken border-line border-b">
                          <tr>
                            <th class="eyebrow px-4 py-2.5 font-normal">Package</th>
                            <th class="eyebrow px-4 py-2.5 font-normal">Before</th>
                            <th class="eyebrow px-4 py-2.5 font-normal">Now</th>
                          </tr>
                        </thead>
                        <tbody class="divide-line divide-y font-mono text-xs">
                          {pkgs.diff.updated.slice(0, DIFF_ROWS).map((u) => (
                            <tr>
                              <td class="text-ink px-4 py-2">{u.name}</td>
                              <td class="text-ink-muted px-4 py-2">{u.from}</td>
                              <td class="text-ink px-4 py-2">{u.to}</td>
                            </tr>
                          ))}
                          {pkgs.diff.added.slice(0, DIFF_ROWS).map((p) => (
                            <tr>
                              <td class="text-ink px-4 py-2">{p.name}</td>
                              <td class="text-ink-faint px-4 py-2 font-sans">added</td>
                              <td class="text-ink px-4 py-2">{p.version}</td>
                            </tr>
                          ))}
                          {pkgs.diff.removed.slice(0, DIFF_ROWS).map((p) => (
                            <tr>
                              <td class="text-ink-muted px-4 py-2 line-through">{p.name}</td>
                              <td class="text-ink-muted px-4 py-2">{p.version}</td>
                              <td class="text-ink-faint px-4 py-2 font-sans">removed</td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                    {diffTruncated && (
                      <p class="text-ink-faint mt-2 text-xs">
                        Showing the first {DIFF_ROWS} of each kind: compare the two packages.json
                        files for the rest.
                      </p>
                    )}
                  </>
                )}
              </div>
            )}
            <details class="border-line mt-5 rounded-xl border">
              <summary class="text-ink cursor-pointer px-4 py-3 text-sm font-medium">
                All {pkgs.packages.length.toLocaleString("en-US")} packages
              </summary>
              <div class="border-line max-h-[28rem] overflow-auto border-t">
                <table class="w-full text-left font-mono text-xs">
                  <tbody class="divide-line divide-y">
                    {pkgs.packages.map((p) => (
                      <tr>
                        <td class="text-ink px-4 py-1.5">{p.name}</td>
                        <td class="text-ink-muted px-4 py-1.5">{p.version}</td>
                        <td class="text-ink-faint px-4 py-1.5">{p.arch}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </details>
          </section>
        )}

        <!-- Previous releases -->
        {image.previous.length > 0 && (
          <section class="mt-14" aria-labelledby="prev-title">
            <h2 id="prev-title" class="text-ink text-xl font-semibold tracking-tight">
              Previous releases
            </h2>
            <p class="text-ink-muted mt-2 text-sm">
              Older versions stay at their immutable paths, useful when you target a specific
              release.
            </p>
            <div class="border-line mt-4 overflow-x-auto rounded-xl border">
              <table class="w-full text-left text-sm">
                <thead class="surface-sunken border-line border-b">
                  <tr>
                    <th class="eyebrow px-4 py-2.5 font-normal">Version</th>
                    <th class="eyebrow px-4 py-2.5 font-normal">File</th>
                    <th class="eyebrow px-4 py-2.5 text-right font-normal">Size</th>
                    <th class="eyebrow px-4 py-2.5 font-normal">Built</th>
                    {stats && (
                      <th class="eyebrow px-4 py-2.5 text-right font-normal" title={downloadsLabel}>
                        Downloads
                      </th>
                    )}
                  </tr>
                </thead>
                <tbody class="divide-line divide-y">
                  {image.previous.map((rel) =>
                    rel.artifacts.map((a) => (
                      <tr>
                        <td class="text-ink px-4 py-3 font-mono">
                          {rel.version}
                          {seriesNote(rel.version) && (
                            <span class="text-ink-faint block font-sans text-xs">
                              {seriesNote(rel.version)}
                            </span>
                          )}
                        </td>
                        <td class="px-4 py-3">
                          {a.fileUrl ? (
                            <a class="link font-mono text-xs" href={a.fileUrl}>
                              {a.filename}
                            </a>
                          ) : (
                            <span class="text-ink-faint">unavailable</span>
                          )}
                        </td>
                        <td class="text-ink-muted px-4 py-3 text-right font-mono">
                          {formatBytes(a.sizeBytes)}
                        </td>
                        <td class="text-ink-muted px-4 py-3">{formatDate(a.manifest?.built_at)}</td>
                        {stats && (
                          <td class="text-ink-muted px-4 py-3 text-right font-mono">
                            {a.downloads?.toLocaleString("en-US") ?? ""}
                          </td>
                        )}
                      </tr>
                    )),
                  )}
                </tbody>
              </table>
            </div>
          </section>
        )}
      </div>

      <!-- Provenance -->
      <aside class="lg:sticky lg:top-24 lg:self-start" aria-labelledby="prov-title">
        <div class="border-line surface-sunken rounded-xl border p-5">
          <h2 id="prov-title" class="eyebrow">
            Provenance
          </h2>
          <dl class="mt-4 space-y-3.5 text-sm">
            {provenance.map((row) => (
              <div class="flex items-baseline justify-between gap-4">
                <dt class="text-ink-faint shrink-0">{row.label}</dt>
                <dd
                  title={row.title}
                  class:list={[
                    "text-ink min-w-0 truncate text-right",
                    row.mono && "font-mono text-xs",
                  ]}
                >
                  {row.href ? (
                    <a class="link" href={row.href}>
                      {row.value}
                    </a>
                  ) : (
                    row.value
                  )}
                </dd>
              </div>
            ))}
          </dl>
          <div class="border-line mt-5 space-y-2 border-t pt-4 text-sm">
            <a
              class="text-ink-muted hover:text-ink flex items-center justify-between"
              href={repoUrl}
            >
              <span>Source repository</span>
              <span aria-hidden="true">↗</span>
            </a>
            {image.upstream_homepage && (
              <a
                class="text-ink-muted hover:text-ink flex items-center justify-between"
                href={image.upstream_homepage}
              >
                <span>Upstream project</span>
                <span aria-hidden="true">↗</span>
              </a>
            )}
            {primary?.manifestUrl && (
              <a
                class="text-ink-muted hover:text-ink flex items-center justify-between"
                href={primary.manifestUrl}
              >
                <span>Raw manifest</span>
                <span aria-hidden="true">↗</span>
              </a>
            )}
          </div>
        </div>
      </aside>
    </div>
  </article>
</Base>
