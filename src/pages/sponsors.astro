---
import { parse } from "yaml";
import Base from "~/layouts/Base.astro";
import raw from "~/data/sponsors.yaml?raw";

type Kind = "time" | "money" | "resources";
interface Sponsor {
  name: string;
  url: string;
  support: Kind[];
  what: string;
  since?: number;
  logo?: string;
}

const { sponsors } = parse(raw) as { sponsors: Sponsor[] };

const kinds: { id: Kind; title: string; text: string }[] = [
  {
    id: "time",
    title: "Time",
    text: "People who maintain the pipeline, review changes, add images and answer issues.",
  },
  {
    id: "resources",
    title: "Resources",
    text: "Cloud capacity for the runtime tests, build runners, object storage and bandwidth.",
  },
  {
    id: "money",
    title: "Money",
    text: "Funding that pays for infrastructure the project cannot get donated.",
  },
];
const label = Object.fromEntries(kinds.map((k) => [k.id, k.title])) as Record<Kind, string>;
const contact = "sponsors@openimages.cloud";
---

<Base
  title="Sponsors"
  description="Who supports Open Image Cloud with time, money or resources, and how to join them."
>
  <article class="mx-auto max-w-3xl px-4 py-14 sm:px-6 sm:py-20">
    <p class="eyebrow">Sponsors</p>
    <h1 class="text-ink mt-3 text-4xl font-semibold tracking-tight">Who keeps the images coming</h1>
    <p class="text-ink-muted mt-4 text-lg leading-relaxed">
      Open Image Cloud is a non-profit community project. Every image is rebuilt, signed and booted
      on a real cloud each time upstream moves, and that work runs on what sponsors give: time,
      money or resources.
    </p>

    <section class="mt-14">
      <h2 class="text-ink text-xl font-semibold tracking-tight">Current sponsors</h2>
      <ul class="mt-6 grid gap-4">
        {sponsors.map((s) => (
          <li class="border-line rounded-xl border p-5">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <a class="text-ink font-medium hover:underline" href={s.url} rel="noopener">
                {s.logo ? <img src={`/img/sponsors/${s.logo}`} alt={s.name} class="h-8" /> : s.name}
              </a>
              <span class="flex flex-wrap gap-2">
                {s.support.map((k) => (
                  <span class="border-line text-ink-muted rounded-full border px-2.5 py-0.5 text-xs">
                    {label[k]}
                  </span>
                ))}
              </span>
            </div>
            <p class="text-ink-muted mt-2 text-sm leading-relaxed">
              {s.what}
              {s.since && <span> Since {s.since}.</span>}
            </p>
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-14">
      <h2 class="text-ink text-xl font-semibold tracking-tight">Ways to support the project</h2>
      <dl class="mt-6 grid gap-6 sm:grid-cols-3">
        {kinds.map((k) => (
          <div class="border-line rounded-xl border p-5">
            <dt class="text-ink font-medium">{k.title}</dt>
            <dd class="text-ink-muted mt-2 text-sm leading-relaxed">{k.text}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="text-ink-muted mt-14 leading-relaxed">
      <h2 class="text-ink text-xl font-semibold tracking-tight">Where the support goes</h2>
      <p class="mt-3">
        Each image release goes through the same steps: the upstream image is downloaded and
        checked, customized in a build runner, signed with cosign, then booted on a real OpenStack
        cloud where a smoke test checks networking, cloud-init, SSH access and the guest agent. Only
        then is it published to object storage and listed in the catalog. Every distribution is
        watched daily for new upstream releases, so this runs many times a week.
      </p>
      <p class="mt-3">
        The recurring costs are the test instances, the storage and bandwidth for every published
        version, and the time spent following upstream changes. Sponsorship keeps all of this free
        for everyone who uses the images, with no account and no paid tier.
      </p>
    </section>

    <section class="text-ink-muted mt-14 leading-relaxed">
      <h2 class="text-ink text-xl font-semibold tracking-tight">Become a sponsor</h2>
      <p class="mt-3">
        Write to{" "}
        <a class="link" href={`mailto:${contact}`}>
          {contact}
        </a>{" "}
        with what you would like to offer. Sponsors are listed here once they agree to be named;
        sponsorship never changes how images are built or tested.
      </p>
    </section>
  </article>
</Base>
