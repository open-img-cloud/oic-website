---
import Base from "~/layouts/Base.astro";
---

<Base title="Page not found" description="This page doesn't exist on openimages.cloud.">
  <section class="relative isolate overflow-hidden">
    <div aria-hidden="true" class="bg-grid absolute inset-0 -z-10 opacity-70"></div>
    <div class="mx-auto max-w-2xl px-4 py-32 text-center sm:px-6">
      <p class="eyebrow">404</p>
      <h1 class="text-ink mt-4 text-4xl font-semibold tracking-tight text-balance sm:text-5xl">
        This page is not in the catalog.
      </h1>
      <p class="text-ink-muted mt-5">It may have moved, or never existed.</p>
      <p class="text-ink-muted mt-2 text-sm">
        Looking for a file? Images live on{" "}
        <a class="link" href="https://images.openimages.cloud/">
          images.openimages.cloud
        </a>
        .
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a
          href="/images/"
          class="bg-brand-600 hover:bg-brand-700 dark:bg-brand-500 dark:hover:bg-brand-400 rounded-lg px-5 py-2.5 text-sm font-medium text-white transition-colors dark:text-slate-950"
        >
          Browse the catalog
        </a>
        <a
          href="/"
          class="border-line-strong text-ink rounded-lg border px-5 py-2.5 text-sm font-medium"
        >
          Home
        </a>
      </div>
    </div>
  </section>
</Base>
