---
import Base from "~/layouts/Base.astro";
import Terminal from "~/components/Terminal.astro";
import ImageRow from "~/components/ImageRow.astro";
import CodeBlock from "~/components/CodeBlock.astro";
import { CERT_IDENTITY_REGEXP, formatDate, loadEnrichedImages } from "~/lib/images";

const images = await loadEnrichedImages();
const active = images.filter((i) => i.status !== "archive");

// Home page: up to six featured images, the rest summarised by family.
const featured = active
  .filter((i) => typeof i.featured === "number")
  .sort((a, b) => (a.featured ?? 99) - (b.featured ?? 99))
  .slice(0, 6);
const featuredNames = new Set(featured.map((i) => i.os_name));
const familyOf = (title: string) => title.replace(/\s+\d[\w.]*(\s+LTS)?$/i, "").trim();
const families = [
  ...images
    .filter((i) => !featuredNames.has(i.os_name))
    .reduce((acc, i) => {
      const name = familyOf(i.title);
      const f = acc.get(name) ?? { name, logo: i.logo, count: 0 };
      f.count += 1;
      acc.set(name, f);
      return acc;
    }, new Map<string, { name: string; logo?: string; count: number }>())
    .values(),
];
const others = images.length - featured.length;

const artifacts = images.flatMap((i) => [
  ...i.latest.artifacts,
  ...i.previous.flatMap((r) => r.artifacts),
]);
const published = artifacts.filter((a) => a.manifest);
const signedShare = published.length
  ? Math.round((published.filter((a) => a.manifest?.signed).length / published.length) * 100)
  : 0;
const lastBuild = images
  .map((i) => i.builtAt)
  .filter((d): d is string => !!d)
  .sort()
  .at(-1);

// Hero terminal: a real, published artifact (first featured image with a manifest).
const demoImage = featured.find((i) => i.latest.artifacts.some((a) => a.fileUrl)) ?? images[0];
const demo = demoImage?.latest.artifacts.find((a) => a.fileUrl) ?? null;
const demoFile = demo?.filename ?? "image.qcow2";
const demoPath = demo?.fileUrl?.replace("https://", "") ?? "images.openimages.cloud/…";

const stats = [
  { value: String(active.length), label: "maintained images" },
  { value: String(published.length), label: "published artifacts" },
  { value: `${signedShare}%`, label: "cosign-signed" },
  { value: formatDate(lastBuild), label: "latest build" },
];

const steps = [
  {
    title: "Watch upstream",
    body: "A daily job detects new upstream releases and opens a pull request bumping the pinned version.",
    detail: "detect-upstream.sh",
  },
  {
    title: "Build",
    body: "Images are customised from official upstream artefacts with libguestfs, diskimage-builder or a Nix flake, inside a signed builder container.",
    detail: "pinned builder digest",
  },
  {
    title: "Boot-test",
    body: "Each image boots in QEMU with a ConfigDrive, then again on a live OpenStack: cloud-init, SSH and DNS must pass.",
    detail: "qemu + Infomaniak",
  },
  {
    title: "Sign",
    body: "Keyless cosign signatures bound to the GitHub Actions identity of the build workflow, logged in Sigstore's Rekor.",
    detail: "sigstore bundle",
  },
  {
    title: "Publish",
    body: "Immutable versioned paths on Swiss object storage, served through a CDN, with checksums and a provenance manifest.",
    detail: "MANIFEST.json",
  },
];

const verifySnippet = `cosign verify-blob ${demoFile} \\
  --bundle ${demoFile}.bundle --new-bundle-format \\
  --certificate-identity-regexp '${CERT_IDENTITY_REGEXP}' \\
  --certificate-oidc-issuer https://token.actions.githubusercontent.com`;
---

<Base
  title="Signed cloud images for OpenStack and Proxmox"
  jsonLd={[
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      name: "Open Image Cloud",
      alternateName: "openimages.cloud",
      url: "https://openimages.cloud/",
      logo: "https://openimages.cloud/img/icon-180.png",
      description:
        "Non-profit community project publishing signed, tested cloud images for OpenStack and Proxmox.",
      sameAs: ["https://github.com/open-img-cloud"],
    },
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: "Open Image Cloud",
      url: "https://openimages.cloud/",
    },
  ]}
>
  <!-- Hero -->
  <section class="relative isolate overflow-hidden">
    <div aria-hidden="true" class="bg-grid absolute inset-0 -z-10 opacity-70"></div>
    <div class="mx-auto grid max-w-6xl gap-12 px-4 pt-16 pb-20 sm:px-6 sm:pt-24 lg:grid-cols-[1.05fr_1fr] lg:items-center lg:gap-16">
      <div>
        <p class="eyebrow">Open source · Signed · Reproducible</p>
        <h1 class="text-ink mt-5 text-4xl leading-[1.05] font-semibold tracking-[-0.025em] text-balance sm:text-5xl lg:text-[3.5rem]">
          Cloud images you can verify, not just trust.
        </h1>
        <p class="text-ink-muted mt-6 max-w-xl text-lg leading-relaxed text-pretty">
          Cloud-init-ready qcow2 images for OpenStack and Proxmox, built in the open from official
          upstream releases. Every file ships with a keyless signature and a manifest saying exactly
          how it was made.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="/images/"
            class="bg-brand-600 hover:bg-brand-700 dark:bg-brand-500 dark:hover:bg-brand-400 inline-flex items-center gap-2 rounded-lg px-5 py-2.5 text-sm font-medium text-white transition-colors dark:text-slate-950"
          >
            Browse the catalog
            <svg viewBox="0 0 16 16" class="h-3.5 w-3.5" fill="none" aria-hidden="true">
              <path
                d="M9.5 3.5l4 4-4 4M2 7.5h11"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
              ></path>
            </svg>
          </a>
          <a
            href="/verify/"
            class="border-line-strong text-ink hover:surface-sunken inline-flex items-center gap-2 rounded-lg border px-5 py-2.5 text-sm font-medium transition-colors"
          >
            How to verify
          </a>
        </div>
      </div>

      <Terminal title={`verify · ${demoImage?.title ?? "image"}`} class="min-w-0">
        <span class="t-line">
          <span class="t-prompt">$</span>
          <span class="t-cmd">curl</span>
          <span class="t-flag">-fLO</span> <span class="t-str">{demoPath}</span>
        </span>
        <span class="t-line">
          <span class="t-prompt">$</span>
          <span class="t-cmd">curl</span>
          <span class="t-flag">-fLO</span> <span class="t-str">{demoPath}.bundle</span>
        </span>
        <span class="t-line"> </span>
        <span class="t-line">
          <span class="t-prompt">$</span>
          <span class="t-cmd">cosign verify-blob</span>
          {demoFile}
        </span>
        <span class="t-cont t-flag">--bundle {demoFile}.bundle --new-bundle-format</span>
        <span class="t-cont t-flag">
          --certificate-identity-regexp '…/open-img-cloud/.github/…'
        </span>
        <span class="t-cont t-flag">
          --certificate-oidc-issuer https://token.actions.githubusercontent.com
        </span>
        <span class="t-line t-ok">Verified OK</span>
        <span class="t-line"> </span>
        <span class="t-line">
          <span class="t-prompt">$</span>
          <span class="t-cmd">jq</span>
          <span class="t-str">'.built_at, .build_url'</span> MANIFEST
          {demo?.label ? `-${demo.manifest?.variant}` : ""}.json
        </span>
        <span class="t-line t-out">"{demo?.manifest?.built_at ?? "2026-01-01T00:00:00Z"}"</span>
        <span class="t-line t-out">
          "{demo?.manifest?.build_url?.replace("https://", "") ?? "github.com/…"}"
        </span>
      </Terminal>
    </div>

    <!-- Stats -->
    <div class="border-line border-y">
      <dl class="divide-line mx-auto grid max-w-6xl grid-cols-2 divide-x sm:grid-cols-4">
        {stats.map((s) => (
          <div class="border-line px-4 py-6 sm:px-6 max-sm:[&:nth-child(-n+2)]:border-b">
            <dt class="eyebrow">{s.label}</dt>
            <dd class="text-ink mt-2 text-2xl font-semibold tracking-tight tabular-nums">
              {s.value}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Catalog -->
  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6" aria-labelledby="catalog-title">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="eyebrow">Catalog</p>
        <h2 id="catalog-title" class="text-ink mt-3 text-3xl font-semibold tracking-tight">
          {active.length} images, one standard.
        </h2>
        <p class="text-ink-muted mt-3 max-w-2xl">
          Same cloud-init policy, same signing, same layout on the registry, whichever distribution
          you pick.
        </p>
      </div>
      <a href="/images/" class="link text-sm">
        See all {images.length} images
      </a>
    </div>
    <div class="border-line mt-8 overflow-hidden rounded-xl border">
      <div class="border-line surface-sunken hidden grid-cols-[2.75rem_minmax(0,1fr)_9rem_8rem_6rem_2.25rem] gap-x-4 border-b px-5 py-2.5 md:grid">
        <span></span>
        <span class="eyebrow">Image</span>
        <span class="eyebrow">Latest</span>
        <span class="eyebrow">Built</span>
        <span class="eyebrow text-right">Size</span>
        <span></span>
      </div>
      <ul class="divide-line divide-y">
        {featured.map((image) => (
          <ImageRow image={image} />
        ))}
      </ul>
    </div>
    {families.length > 0 && (
      <div class="mt-6">
        <p class="text-ink-muted text-sm">And {others} more, from these families:</p>
        <ul class="mt-3 flex flex-wrap gap-2">
          {families.map((f) => (
            <li>
              <a
                href={`/images/?q=${encodeURIComponent(f.name.toLowerCase())}`}
                class="border-line text-ink hover:border-[var(--accent)] inline-flex items-center gap-2 rounded-full border px-3 py-1.5 text-sm transition-colors"
              >
                {f.logo && (
                  <img src={`/img/logos/${f.logo}`} alt="" width="16" height="16" class="h-4 w-4" />
                )}
                {f.name}
                {f.count > 1 && <span class="text-ink-faint">{f.count}</span>}
              </a>
            </li>
          ))}
        </ul>
        <a
          href="/images/"
          class="mt-6 inline-flex items-center rounded-lg bg-[var(--accent)] px-4 py-2 text-sm font-medium text-white"
        >
          See all {images.length} images
        </a>
      </div>
    )}
  </section>

  <!-- How it works -->
  <section
    id="how-it-works"
    class="border-line surface-sunken border-y"
    aria-labelledby="how-title"
  >
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
      <p class="eyebrow">How it works</p>
      <h2 id="how-title" class="text-ink mt-3 text-3xl font-semibold tracking-tight">
        From upstream release to verified download.
      </h2>
      <p class="text-ink-muted mt-3 max-w-2xl">
        Every step runs in public GitHub Actions workflows. Nothing is built on a laptop.
      </p>
      <ol class="mt-12 grid gap-px overflow-hidden rounded-xl border border-line bg-[var(--line)] sm:grid-cols-2 lg:grid-cols-5">
        {steps.map((step, i) => (
          <li class="surface flex flex-col p-6">
            <span class="text-accent font-mono text-xs">0{i + 1}</span>
            <h3 class="text-ink mt-3 font-semibold">{step.title}</h3>
            <p class="text-ink-muted mt-2 text-sm leading-relaxed">{step.body}</p>
            <p class="text-ink-faint mt-auto pt-5 font-mono text-[11px]">{step.detail}</p>
          </li>
        ))}
      </ol>
      <p class="text-ink-faint mt-6 text-sm">
        Workflows and standards live in{" "}
        <a class="link" href="https://github.com/open-img-cloud/.github">
          open-img-cloud/.github
        </a>
        .
      </p>
    </div>
  </section>

  <!-- Verify -->
  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6" aria-labelledby="verify-title">
    <div class="grid gap-10 lg:grid-cols-[1fr_1.3fr] lg:items-center">
      <div>
        <p class="eyebrow">Verification</p>
        <h2 id="verify-title" class="text-ink mt-3 text-3xl font-semibold tracking-tight">
          No keys to manage. One command.
        </h2>
        <p class="text-ink-muted mt-4 leading-relaxed">
          Signatures are tied to the identity of our build workflow through GitHub OIDC and recorded
          in Sigstore's public transparency log. If the command prints{" "}
          <code class="text-ink font-mono text-sm">Verified OK</code>, the file was produced by our
          CI, unmodified.
        </p>
        <a href="/verify/" class="link mt-6 inline-block text-sm">
          Step-by-step verification guide
        </a>
      </div>
      <CodeBlock code={verifySnippet} label="bash" />
    </div>
  </section>
</Base>
