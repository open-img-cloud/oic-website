---
import Logo from "~/components/Logo.astro";
import { loadEnrichedImages } from "~/lib/images";

const all = await loadEnrichedImages();
// Featured images only; the full list lives in the catalog.
const images = all
  .filter((i) => i.status !== "archive" && typeof i.featured === "number")
  .sort((a, b) => (a.featured ?? 99) - (b.featured ?? 99));
const year = new Date().getFullYear();

const project = [
  { href: "/#how-it-works", label: "How it works" },
  { href: "/about/", label: "About the project" },
  { href: "/quality/", label: "How images are tested" },
  { href: "/verify/", label: "Verify an image" },
  { href: "/sponsors/", label: "Sponsors" },
  { href: "https://images.openimages.cloud/", label: "Image registry" },
  {
    href: "https://github.com/open-img-cloud/.github/blob/main/docs/IMAGE_STANDARDS.md",
    label: "Image standards",
  },
];
const source = [
  { href: "https://github.com/open-img-cloud", label: "GitHub organisation" },
  { href: "https://github.com/open-img-cloud/.github", label: "Build workflows" },
  { href: "https://github.com/open-img-cloud/oic-website", label: "This website" },
  { href: "https://github.com/open-img-cloud/.github/issues", label: "Request an image" },
];
---

<footer class="border-line surface-sunken border-t">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
    <div>
      <p class="text-ink flex items-center gap-2.5 font-semibold tracking-tight">
        <Logo mono class="h-7 w-7 shrink-0" />
        Open Image Cloud
      </p>
      <p class="text-ink-muted mt-3 max-w-xs text-sm leading-relaxed">
        Signed, reproducible cloud images for OpenStack and Proxmox. Stored in Switzerland, served
        worldwide.
      </p>
    </div>
    <nav aria-label="Images">
      <p class="eyebrow">Images</p>
      <ul class="mt-4 space-y-2.5 text-sm">
        {images.map((image) => (
          <li>
            <a href={`/images/${image.os_name}/`} class="text-ink-muted hover:text-ink">
              {image.title}
            </a>
          </li>
        ))}
        <li>
          <a href="/images/" class="link">
            All {all.length} images
          </a>
        </li>
      </ul>
    </nav>
    <nav aria-label="Project">
      <p class="eyebrow">Project</p>
      <ul class="mt-4 space-y-2.5 text-sm">
        {project.map((l) => (
          <li>
            <a href={l.href} class="text-ink-muted hover:text-ink">
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <nav aria-label="Source">
      <p class="eyebrow">Source</p>
      <ul class="mt-4 space-y-2.5 text-sm">
        {source.map((l) => (
          <li>
            <a href={l.href} class="text-ink-muted hover:text-ink">
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
  <div class="border-line border-t">
    <div class="text-ink-faint mx-auto flex max-w-6xl flex-col gap-2 px-4 py-6 text-xs sm:flex-row sm:justify-between sm:px-6">
      <p>
        © {year} Open Image Cloud. Images under their upstream licenses, tooling under GPL-2.0.
        Distribution logos are trademarks of their respective owners.
      </p>
      <p>
        Website under{" "}
        <a class="link" href="https://www.apache.org/licenses/LICENSE-2.0">
          Apache-2.0
        </a>
        .
      </p>
    </div>
  </div>
</footer>
