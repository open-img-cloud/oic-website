---
// "EOL soon" / "EOL" next to an image title, from the endoflife.date support dates.
import { formatDate, type Support } from "~/lib/images";

interface Props {
  support: Support | null;
}
const { support } = Astro.props;
const eol = support?.isEol ?? false;
const show = support && (eol || support.eolSoon);
---

{show && (
  <span
    class:list={[
      "inline-flex items-center gap-1.5 rounded-full border px-2 py-0.5 text-[11px] font-medium",
      eol
        ? "text-bad border-[color-mix(in_oklch,var(--bad)_40%,transparent)]"
        : "text-warn border-[color-mix(in_oklch,var(--warn)_40%,transparent)]",
    ]}
    title={`${eol ? "End of life since" : "End of life on"} ${formatDate(support.securityUntil)}`}
  >
    <span class="h-1.5 w-1.5 rounded-full bg-current" aria-hidden="true"></span>
    {eol ? "EOL" : "EOL soon"}
  </span>
)}
