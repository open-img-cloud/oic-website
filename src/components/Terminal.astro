---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  title?: string;
}
const { title = "bash", class: className, ...rest } = Astro.props;
---

<div
  class:list={[
    "border-line-strong overflow-hidden rounded-xl border bg-[#0b1220] shadow-[0_24px_60px_-28px_rgba(8,15,35,0.45)]",
    className,
  ]}
  {...rest}
>
  <div class="flex items-center gap-2 border-b border-white/10 px-4 py-2.5">
    <span class="h-2.5 w-2.5 rounded-full bg-white/15" aria-hidden="true"></span>
    <span class="h-2.5 w-2.5 rounded-full bg-white/15" aria-hidden="true"></span>
    <span class="h-2.5 w-2.5 rounded-full bg-white/15" aria-hidden="true"></span>
    <span class="ml-2 font-mono text-[11px] tracking-wide text-slate-400">{title}</span>
  </div>
  <div class="terminal-body overflow-x-auto px-4 py-4 font-mono text-[12.5px] leading-[1.75] whitespace-pre text-slate-200 sm:px-5 sm:text-[13px]">
    <slot />
  </div>
</div>

<style>
  /* One rendered line per child of the terminal body. Astro's HTML compiler
     collapses whitespace between sibling spans, so we rely on block-level
     line wrappers instead of \n in the source. */
  .terminal-body > :global(.t-line) {
    display: block;
    min-height: 1lh;
  }

  /* Tokens for in-line snippet semantics: keep small and predictable. */
  :global(.t-comment) {
    color: var(--color-slate-500);
  }
  :global(.t-prompt) {
    color: var(--color-brand-300);
    user-select: none;
    margin-right: 0.5ch;
  }
  :global(.t-cmd) {
    color: var(--color-slate-50);
  }
  :global(.t-flag) {
    color: var(--color-slate-400);
  }
  :global(.t-str) {
    color: var(--color-amber-300, #fcd34d);
  }
  :global(.t-out) {
    color: var(--color-slate-400);
  }
  :global(.t-ok) {
    color: var(--color-emerald-300, #6ee7b7);
  }
  :global(.t-cont) {
    /* Continuation indent for wrapped flag lines. */
    padding-left: 2ch;
    display: block;
  }
</style>
