---
import Logo from "~/components/Logo.astro";
import ThemeToggle from "~/components/ThemeToggle.astro";

const links = [
  { href: "/images/", label: "Catalog" },
  { href: "/#how-it-works", label: "How it works", wide: true },
  { href: "/quality/", label: "Quality" },
  { href: "/verify/", label: "Verify" },
  { href: "/about/", label: "About", wide: true },
];
const currentPath = Astro.url.pathname;
---

<header class="border-line sticky top-0 z-30 border-b bg-[color-mix(in_oklch,var(--surface)_82%,transparent)] backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
    <a
      href="/"
      class="text-ink flex items-center gap-2.5 font-semibold tracking-tight"
      aria-label="Open Image Cloud, home"
    >
      <Logo class="h-8 w-8" />
      <span class="hidden sm:inline">Open Image Cloud</span>
    </a>
    <nav class="flex items-center gap-1 text-sm" aria-label="Main">
      {links.map((link) => {
        const active = link.href !== "/#how-it-works" && currentPath.startsWith(link.href);
        return (
          <a
            href={link.href}
            aria-current={active ? "page" : undefined}
            class:list={[
              "rounded-md px-3 py-2 transition-colors",
              link.wide && "hidden md:inline-block",
              active ? "text-ink font-medium" : "text-ink-muted hover:text-ink",
            ]}
          >
            {link.label}
          </a>
        );
      })}
      <a
        href="https://github.com/open-img-cloud"
        class="text-ink-muted hover:text-ink inline-flex h-9 w-9 items-center justify-center rounded-md transition-colors"
        aria-label="Open Image Cloud on GitHub"
      >
        <svg viewBox="0 0 16 16" class="h-[18px] w-[18px]" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path>
        </svg>
      </a>
      <ThemeToggle />
    </nav>
  </div>
</header>
